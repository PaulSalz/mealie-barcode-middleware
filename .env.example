# ── Required: Mealie Connection ──────────────────────────────────────
MEALIE_URL=http://your-mealie-ip:9925
MEALIE_API_KEY=your-mealie-api-key-here
# Shopping lists are discovered automatically. Choose the default in Settings → Mealie.
# MEALIE_SHOPPING_LIST_ID=your-shopping-list-uuid-here  # optional legacy fallback only

# Browser/deep-link URL for this middleware. Create b2m.local in your LAN DNS/mDNS first.
MIDDLEWARE_BASE_URL=http://b2m.local:9930

# ── Barcode Lookup Sources ──────────────────────────────────────────
# OpenFoodFacts — free, no key needed, good EU coverage (enabled by default)
# OFF_ENABLED=true
# OFF_URL_BASE=https://world.openfoodfacts.org/api/v2/product/

# UPCDatabase — good US coverage, requires free API key (disabled by default)
# UPCDB_ENABLED=false
# UPCDB_URL_BASE=https://api.upcdatabase.org/product/
# UPCDB_API_KEY=your-upcdatabase-api-key

# ── Lookup Strategy (only relevant when both sources are enabled) ───
# LOOKUP_PRIMARY=off                # Which API is tried first: off | upcdb
# LOOKUP_STRATEGY=failover          # failover  = secondary only when primary finds nothing
#                                   # complement = fill empty brand/qty/type from secondary
# LOOKUP_ENRICH_IN_BACKGROUND=true  # complement: run secondary after responding to the scanner

# ── Matching & Sync ─────────────────────────────────────────────────
# FUZZY_MATCH_THRESHOLD=85
# FUZZY_AMBIGUITY_GAP=10
# ITEM_SYNC_INTERVAL_HOURS=6
# LOOKUP_TTL_DAYS=30
# MAX_RETRY_ATTEMPTS=10

# ── Home Assistant ───────────────────────────────────────────────────
# HA_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/barcode-scanner

# ── Web notification defaults ────────────────────────────────────────
# Runtime-editable in Settings → Notifications.
# NOTIFICATION_TOAST_SECONDS=15
# NOTIFICATION_GROUP_WINDOW_SECONDS=30

# ── Optional NIIMBOT / niimblue-node printing ───────────────────────
# Run niimblue-node's REST server on a host with Bluetooth/serial access.
# Example B21 Pro defaults: 300 dpi, max 50 mm width, D110M_V4 print task.
# NIIMBLUE_URL=http://192.168.88.160:3010
# NIIMBLUE_TRANSPORT=ble
# NIIMBLUE_ADDRESS=AA:BB:CC:DD:EE:FF
# NIIMBLUE_PRINT_TASK=D110M_V4
# NIIMBLUE_PRINT_DIRECTION=top
# NIIMBLUE_DENSITY=3
# NIIMBLUE_LABEL_TYPE=1
# NIIMBLUE_DPI=300
# NIIMBLUE_MAX_LABEL_WIDTH_MM=50
# NIIMBLUE_TIMEOUT=30

# ── System ──────────────────────────────────────────────────────────
# TIMEZONE=Europe/Berlin
# SESSION_MAX_AGE_DAYS=7
# DB_PATH=/data/barcode.db
# PORT=8000
# LOG_LEVEL=INFO